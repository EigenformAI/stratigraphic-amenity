{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "stratigraphic-amenity": {
      "type": "local",
      "command": ["uv", "run", "--no-sync", "stratigraphic-amenity-mcp"],
      "environment": {
        "GEOMAP_DATA_ROOT": "./data",
        "GEOMAP_CACHE_ROOT": "./.cache",
        "GEOMAP_MCP_ALLOWED_ROOTS": "./data:./.cache"
      },
      "enabled": true,
      "timeout": 180000
    }
  }
}
