# Python does not load this file automatically. Export values in the shell or
# pass them through the MCP host. Relative values resolve from the launch directory.
GEOMAP_DATA_ROOT=
GEOMAP_MODEL_ROOT=
GEOMAP_ULTRALYTICS_ROOT=
GEOMAP_KNOWLEDGE_ROOT=
GEOMAP_KNOWLEDGE_SOURCES_ROOT=
GEOMAP_CACHE_ROOT=
GEOMAP_MCP_ALLOWED_ROOTS=
# Detector preparation is exposed by default. Set to false to withhold the tool.
GEOMAP_MCP_ENABLE_DETECTOR_PREPARATION=true
GEOMAP_LOG_LEVEL=INFO
GEOMAP_DATASET_SOURCE=usgs
GEOMAP_EARTHQUAKE_CSV=
GEOMAP_ACTIVE_FAULT_GEOJSON=
GEOMAP_EARTHQUAKE_SOURCE_ID=usgs_fdsn_events
GEOMAP_EARTHQUAKE_SOURCE_IDS=usgs_fdsn_events,emsc_fdsn_events
GEOMAP_ACTIVE_FAULT_SOURCE_ID=gem_global_active_faults
GEOMAP_ACTIVE_FAULT_SOURCE_IDS=gem_global_active_faults,diss_seismogenic_sources
GEOMAP_MINERAL_OCCURRENCE_SOURCE_ID=ontario_mineral_deposit_inventory
GEOMAP_MINERAL_OCCURRENCE_SOURCE_IDS=ontario_mineral_deposit_inventory,sigeom_mineral_occurrences
GEOMAP_GEM_ACTIVE_FAULT_VERSION=
GEOMAP_EARTHENGINE_PROJECT=
GEOMAP_KNOWLEDGE_EARTHQUAKE_ENGINE=auto
GEOMAP_KNOWLEDGE_FAULT_GEOMETRY_ENGINE=auto
GEOMAP_EARTHENGINE_LANDCOVER_DATASET=ESA/WorldCover/v200
GEOMAP_EARTHENGINE_POPULATION_DATASET=WorldPop/GP/100m/pop
GEOMAP_EARTHENGINE_SCALE=100
GEOMAP_EARTHENGINE_MAX_PIXELS=100000000
GEOMAP_K2_ROCK_TYPE_JSON=
GEOMAP_K2_ROCK_AGE_JSON=
GEOMAP_K2_ROCK_DETAIL_JSON=
GEOMAP_K2_USAGE_JSON=
GEOMAP_K2_EXPERTISE_JSON=
GEOMAP_SEMANTIC_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
GEOMAP_SEMANTIC_MODEL_REVISION=
GEOMAP_SEMANTIC_DEVICE=auto
GEOMAP_SEMANTIC_TOP_K=5
GEOMAP_SEMANTIC_MIN_SCORE=
GEOMAP_SEMANTIC_BATCH_SIZE=32
GEOMAP_SEMANTIC_LOCAL_FILES_ONLY=false
